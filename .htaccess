Options +Indexes
IndexOptions Charset=UTF-8 FancyIndexing FoldersFirst HTMLTable IconsAreLinks IgnoreCase SuppressRules VersionSort SuppressHTMLPreamble SuppressDescription SuppressColumnSorting
IndexIgnore tpl robots.txt
HeaderName /tpl/header.html
ReadmeName /tpl/readme.html

AddIcon /tpl/icons/folder.png ^^DIRECTORY^^
AddIcon /tpl/icons/opened-folder.png ..

AddIcon /tpl/icons/zip.png .zip
AddIcon /tpl/icons/7zip.png .7z
AddIcon /tpl/icons/rar.png .rar
AddIcon /tpl/icons/tar.png .tar

AddIcon /tpl/icons/exe.png .exe
AddIcon /tpl/icons/java.png .jar
AddIcon /tpl/icons/python.png .py

AddIcon /tpl/icons/csv.png .csv
AddIcon /tpl/icons/xml.png .xml

AddIcon /tpl/icons/html.png .html
AddIcon /tpl/icons/txt.png .txt

AddIcon /tpl/icons/gif.png .gif
AddIcon /tpl/icons/jpg.png .jpg
AddIcon /tpl/icons/png.png .png
AddIcon /tpl/icons/webp.png .webp
AddIcon /tpl/icons/bmp.png .bmp

DefaultIcon /tpl/icons/document.png

SetEnvIfNoCase User-Agent "^Googlebot" search_bot
SetEnvIfNoCase User-Agent "^Yandex" search_bot
SetEnvIfNoCase User-Agent "^Yahoo" search_bot
SetEnvIfNoCase User-Agent "^Aport" search_bot
SetEnvIfNoCase User-Agent "^msnbot" search_bot
SetEnvIfNoCase User-Agent "^spider" search_bot
SetEnvIfNoCase User-Agent "^Robot" search_bot
SetEnvIfNoCase User-Agent "^php" search_bot
SetEnvIfNoCase User-Agent "^Mail" search_bot
SetEnvIfNoCase User-Agent "^bot" search_bot
SetEnvIfNoCase User-Agent "^igdeSpyder" search_bot
SetEnvIfNoCase User-Agent "^Snapbot" search_bot
SetEnvIfNoCase User-Agent "^WordPress" search_bot
SetEnvIfNoCase User-Agent "^BlogPulseLive" search_bot
SetEnvIfNoCase User-Agent "^Parser" search_bot

